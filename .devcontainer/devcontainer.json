{
  "name": "Kotlin 2.3.21 + Java 25",
  "build": { "dockerfile": "Dockerfile" },
  "containerEnv": {
    "JAVA_HOME": "/opt/jdk-25",
    "PATH": "/opt/jdk-25/bin:/usr/local/sdkman/candidates/gradle/current/bin:${containerEnv:PATH}"
  },
  "extensions": [
    "JetBrains.kotlin",
    "vscjava.vscode-gradle"
  ],
  "settings": {
    "kotlin.languageServer.enabled": true,
    "kotlin.gradle.enabled": true,
    "kotlin.gradle.javaHome": "/opt/jdk-25",
    "gradle.java.home": "/opt/jdk-25",
    "java.configuration.runtimes": [
      {
        "name": "JavaSE-25",
        "path": "/opt/jdk-25",
        "default": true
      }
    ]
  },
  "mounts": [
    "source=gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "postCreateCommand": [
    "gradle wrapper --gradle-version 8.12",
    "./gradlew build --no-daemon -x test"
  ],
  "remoteUser": "vscode"
}
