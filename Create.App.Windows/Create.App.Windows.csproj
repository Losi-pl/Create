<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PublishReadyToRun>true</PublishReadyToRun>
        <LangVersion>10</LangVersion>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en</NeutralLanguage>
        <FileVersion>1.0.0.0</FileVersion>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Icon.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Private.Uri" Version="4.3.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Create\Create.csproj" />
    </ItemGroup>

    <Target Name="BuildAndRunCompiler" BeforeTargets="RunResourceCompiler" 
            Condition="!Exists('$(MSBuildThisFileDirectory)..\Create.Resource.Compiler\bin\Release\net8.0\Create.Resource.Compiler.dll')">
        <Exec Command="dotnet build ..\Create.Resource.Compiler\Create.Resource.Compiler.csproj -c Release" />
    </Target>

    <Target Name="RunResourceCompiler" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug'">
        <PropertyGroup>
            <CompilerExePath>$(MSBuildThisFileDirectory)..\Create.Resource.Compiler\bin\Release\net8.0\Create.Resource.Compiler.dll</CompilerExePath>

            <SourceResourcePath>$(MSBuildThisFileDirectory)..\Create\Resources\</SourceResourcePath>
            <DestResourcePath>$(MSBuildThisFileDirectory)$(OutDir)create.resources</DestResourcePath>
        </PropertyGroup>

        <Exec Command="dotnet &quot;$(CompilerExePath)&quot; &quot;$(SourceResourcePath);$(DestResourcePath);&quot;" />
    </Target>

</Project>
