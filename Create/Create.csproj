  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Create.OpenGL\Create.OpenGL.csproj">
      <Private>True</Private>
      <PrivateAssets></PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\Create.Resource\Create.Resource.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Create.SourceGenerators\Create.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OneOf" Version="3.0.255" PrivateAssets="compile" />
    <PackageReference Include="OneOf.SourceGenerator" Version="3.0.255" PrivateAssets="compile" />
  </ItemGroup>

</Project>
