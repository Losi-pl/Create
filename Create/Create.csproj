<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*" />
        <EmbeddedResource Update="@(EmbeddedResource)">
            <LogicalName>$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Arch" Version="2.1.0" />
      <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
      <PackageReference Include="Nerdbank.MessagePack" Version="1.2.30" />
      <PackageReference Include="OneOf" Version="3.0.271" />
      <PackageReference Include="OneOf.SourceGenerator" Version="3.0.271" />
      <PackageReference Include="Serilog" Version="4.4.0-dev-02437" />
      <PackageReference Include="Silk.NET" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Direct3D12" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Input.Extensions" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
      <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
      <PackageReference Include="Silk.NET.SPIRV.Reflect" Version="2.23.0" />
      <PackageReference Include="StbImageSharp" Version="2.30.15" />
      <PackageReference Include="System.Text.Json" Version="11.0.0-preview.5.26302.115" />
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Resources\" />
    </ItemGroup>

</Project>
